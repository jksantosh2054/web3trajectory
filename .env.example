# Copy to .env and fill in. NEVER commit .env with real values.

# --- Postgres ---
POSTGRES_DB=nexus
POSTGRES_USER=nexus
POSTGRES_PASSWORD=change-me-in-production

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- API ---
SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000

# --- Settlement: fiat | simulated | onchain ---
# Nepal production MUST be fiat (crypto settlement disabled pending legal clearance).
SETTLEMENT_MODE=simulated
PLATFORM_FEE_PCT=5.0

# --- eSewa (fiat) ---
ESEWA_MERCHANT_ID=
ESEWA_SECRET_KEY=
ESEWA_BASE_URL=https://rc-epay.esewa.com.np   # sandbox; prod differs

# --- Khalti (fiat) ---
KHALTI_PUBLIC_KEY=
KHALTI_SECRET_KEY=
KHALTI_BASE_URL=https://dev.khalti.com/api/v2  # sandbox; prod differs

# --- KMS (insight-asset payload encryption) ---
KMS_PROVIDER=vault            # vault | aws_kms | local_dev
KMS_URL=
KMS_TOKEN=

# --- Object storage (MinIO / S3) ---
S3_ENDPOINT=http://storage:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=nexus

# --- Chain (web3-dev / future cleared jurisdiction) ---
CHAIN_RPC_URL=http://chain:8545
CHAIN_ID=31337
INSIGHT_TOKEN_ADDRESS=
AUCTION_HOUSE_ADDRESS=
DEPLOYER_PRIVATE_KEY=   # local dev only; NEVER in production env files

# --- Routing ---
VALHALLA_TILE_DIR=/data/valhalla_tiles
